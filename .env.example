# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session & Payment Security
SESSION_SECRET="change_this_to_a_long_random_secret"
PAYMENT_WEBHOOK_SECRET="change_this_to_a_payment_hmac_secret"

# Optional Payment Gateways (FCFA / Africa)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
FEDAPAY_SECRET_KEY=""

# Optional Transactional Email (Brevo / Resend)
BREVO_API_KEY=""
MAIL_FROM="noreply@zola.africa"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
FACEBOOK_APP_ID=""
APPLE_CLIENT_ID=""

# Optional WebRTC TURN Server
VITE_TURN_URL=""
VITE_TURN_USER=""
VITE_TURN_PASS=""
