# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session & Payment Security
SESSION_SECRET="change_this_to_a_long_random_secret"
PAYMENT_WEBHOOK_SECRET="change_this_to_a_payment_hmac_secret"

# SasPay Payment Gateway (https://docs.saspay.me/)
SASPAY_SECRET_KEY=""
SASPAY_WEBHOOK_SECRET=""
SASPAY_BASE_URL="https://api.saspay.me/api/v1"

# Optional Transactional Email (Brevo / Resend)
BREVO_API_KEY=""
MAIL_FROM="noreply@zola.africa"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
FACEBOOK_APP_ID=""
APPLE_CLIENT_ID=""

# Optional WebRTC TURN Server
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
